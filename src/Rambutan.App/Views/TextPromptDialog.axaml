<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Rambutan.App.Controls"
        xmlns:l="using:Rambutan.App.Localization"
        x:Class="Rambutan.App.Views.TextPromptDialog"
        Width="420" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="#FF16161C">

  <controls:DialogFrame>
  <Border>
  <Grid RowDefinitions="Auto,Auto" Margin="16,8" VerticalAlignment="Top">
    <TextBox x:Name="InputBox" Grid.Row="0" VerticalAlignment="Top"
             KeyDown="OnKeyDown" />
    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10"
                HorizontalAlignment="Right" Margin="0,8,0,0">
      <Button Content="{l:T common.cancel}" IsCancel="True" Click="OnCancel" />
      <Button Content="{l:T common.ok}" Classes="accent" Click="OnAccept" />
    </StackPanel>
  </Grid>
  </Border>
  </controls:DialogFrame>
</Window>

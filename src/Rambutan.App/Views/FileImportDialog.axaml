<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Rambutan.App.Controls" xmlns:l="using:Rambutan.App.Localization"
        x:Class="Rambutan.App.Views.FileImportDialog" Width="360" Height="640"
        Background="{StaticResource Token.Brush.Ground}">
  <controls:DialogFrame>
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="20" Spacing="16">
        <TextBlock x:Name="Status" TextWrapping="Wrap" />
        <Button Content="{l:T common.cancel}" IsCancel="True" Click="OnCancel" />
      </StackPanel>
    </ScrollViewer>
  </controls:DialogFrame>
</Window>

<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Rambutan.App.Controls"
        xmlns:l="using:Rambutan.App.Localization"
        x:Class="Rambutan.App.Views.ConfirmDialog"
        Title="{l:T dialog.confirm.title}"
        Width="420" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="#FF16161C">

  <controls:DialogFrame>
  <Border>
  <Grid RowDefinitions="*,Auto" Margin="20">
    <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Disabled">
    <TextBlock x:Name="Message" TextWrapping="Wrap"
               VerticalAlignment="Top" MinHeight="40" />
    </ScrollViewer>
    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10"
                HorizontalAlignment="Right" Margin="0,14,0,0">
      <Button Content="{l:T common.cancel}" IsCancel="True" Click="OnCancel" />
      <Button x:Name="AcceptButton" Content="{l:T common.ok}" Classes="accent" IsDefault="True" Click="OnAccept" />
    </StackPanel>
  </Grid>
  </Border>
  </controls:DialogFrame>
</Window>
